{
  "name": "module-template",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite build --watch",
    "build": "npm-run-all -p build:*",
    "build:bundle": "CI=1 vite build",
    "build:tsc": "tsc --noEmit",
    "build:test": "CI=1 vitest",
    "build:lint": "oxlint",
    "gen:map": "node tools/map/hex/gen-map.ts",
    "gen:map:area": "node tools/map/area/gen-map.ts",
    "edit:terrain": "node tools/terrain-editor.ts",
    "rename": "node tools/rename.ts",
    "test": "vitest",
    "fuzz": "cd ../../server && bin/rtt-fuzz module-template"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@xmldom/xmldom": "^0.9.12",
    "npm-run-all2": "^9.1.0",
    "oxlint": "^1.94.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "dependencies": {
    "@rzymek/rally-the-troops-module": "^0.5.0"
  }
}
